# Copier ce fichier en .env et remplir les valeurs (le .env n'est jamais versionné)

# Sel secret pour pseudonymiser les identifiants Steam (RGPD)
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
PSEUDO_SALT=

# Périmètre de collecte
GAME_LIMIT=2000
REVIEWS_PER_GAME=20

# Base PostgreSQL du partenaire (source "base de données")
PARTNER_DB_USER=partner
PARTNER_DB_PASSWORD=
PARTNER_DB_HOST=localhost
PARTNER_DB_PORT=5435
# Compte en lecture seule utilisé par l'extraction
PARTNER_READER_PASSWORD=

# Spark Thrift Server (source "big data")
SPARK_HOST=localhost
SPARK_PORT=10000

# Base GameScope (stockage du projet, C4)
GAMESCOPE_DB_USER=gamescope_admin
GAMESCOPE_DB_PASSWORD=
GAMESCOPE_DB_HOST=localhost
GAMESCOPE_DB_PORT=5436
# Rôle utilisé par l'API (C5) et rôle lecture seule de l'équipe data
GAMESCOPE_API_PASSWORD=
GAMESCOPE_ANALYST_PASSWORD=

# RGPD : durées de conservation (procédure de tri, database/rgpd_cleanup.py)
REVIEW_RETENTION_YEARS=3
API_USER_INACTIVITY_YEARS=2

# API REST (C5)
# Clé de signature des jetons JWT : 32 caractères minimum
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=30
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=5/minute
# Origines web autorisées (CORS), séparées par des virgules. Vide = aucune
CORS_ORIGINS=

# Supervision (Uptime Kuma, scripts/setup_monitoring.py)
UPTIME_KUMA_USER=admin
UPTIME_KUMA_PASSWORD=
